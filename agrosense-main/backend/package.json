{
  "name": "agrosense-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API and MQTT gateway for AgroSense",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "NODE_ENV=test tsx --test tests/**/*.test.ts",
    "sim": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "mqtt": "5.15.2",
    "pg": "8.23.0",
    "socket.io": "4.8.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
